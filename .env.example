# Copy to .env (git-ignored) and fill in. Real environment variables override this file.
# Local development: DJANGO_DEBUG=1. Production: leave it unset or 0.
DJANGO_DEBUG=1
# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1,[::1]
# Production only, e.g. https://*.yourdomain.in
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://postgres@localhost:5432/college_erp_dev

# Google reCAPTCHA v2 (login form). Leave both empty to skip the captcha when DJANGO_DEBUG=1.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Email (password reset). Use an app password for the sending mailbox, never your normal password.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Push notifications (leave empty to disable). FIREBASE_WEB_CONFIG is your own project's web config as one line of JSON.
FCM_SERVER_KEY=
FIREBASE_WEB_CONFIG=

# Only behind a proxy you control, e.g. HTTP_X_FORWARDED_FOR (see docs/SECURITY_AUDIT.md)
AUDIT_CLIENT_IP_HEADER=

# Django admin: only OUR staff. Comma-separated e-mails allowed to use it (they also need a superuser
# account and an authenticator app: python manage.py create_platform_admin <college-schema> <email>).
PLATFORM_ADMIN_EMAILS=
# Optional: change the admin URL path (default platform-admin/)
DJANGO_ADMIN_URL=
